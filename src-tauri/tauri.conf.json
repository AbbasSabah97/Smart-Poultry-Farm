{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Poultry Farm",
  "version": "1.1.1",
  "identifier": "io.smartpoultry.farm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smart Poultry Farm | Seven Houses 3D",
        "width": 1500,
        "height": 900,
        "minWidth": 780,
        "minHeight": 580,
        "backgroundColor": "#08141d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
